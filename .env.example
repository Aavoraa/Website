# Copy to .env and fill in when the integrations are available.
# Every value is optional: the site works (honestly) without them.

# Endpoint that accepts a JSON POST of the enquiry form
# (e.g. a CRM webhook, Formspree, HubSpot, n8n, or your own API).
# When empty, the form validates and then offers to open a pre-filled email instead.
PUBLIC_FORM_ENDPOINT=

# Discovery-call booking link (Calendly, Cal.com, Google Calendar appointment page...).
# When empty, "Book a Discovery Call" scrolls to the enquiry form.
PUBLIC_BOOKING_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (loaded only when set).
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification token (content value only).
PUBLIC_GSC_VERIFICATION=
