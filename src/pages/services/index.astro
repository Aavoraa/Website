---
import Page from '../../layouts/Page.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import Icon from '../../components/Icon.astro';
import StepGrid from '../../components/StepGrid.astro';
import Tools from '../../components/Tools.astro';
import PageCTA from '../../components/PageCTA.astro';
import { pillars } from '../../data/site';
import PillarArt from '../../components/PillarArt.astro';
import { serviceDetails, servicePath, subServicePath, subSlug, startSteps } from '../../data/pages';
---

<Page
  title="Services | Software, Branding, Marketing & AI Automation | AAVORAA"
  description="Explore AAVORAA's services: software and app development, branding and creative, marketing and lead generation, and AI and business automation — delivered by one accountable team."
  path="/services/"
  eyebrow="Our Services"
  heading="Every Capability Your Growth Needs."
  accent="One Accountable Team."
  intro="Strategy, creative, code, campaigns and automation — delivered end to end by one team, so nothing gets lost between vendors."
  crumbs={[{ label: 'Services' }]}
>
  <section class="section theme-dark flip" data-theme="dark" aria-label="Service lines">
    <div class="container svc-list">
      {
        pillars.map((p, i) => (
          <article class:list={['svc', { 'svc--rev': i % 2 === 1 }]} id={p.key}>
            <a class="svc__media" href={servicePath(p.key)} tabindex="-1" aria-hidden="true" data-reveal="scale">
              <PillarArt kind={p.key} word={p.visual} />
            </a>
            <div class="svc__text">
              <p class="svc__label" data-reveal>
                <span>0{i + 1}</span> {p.label}
              </p>
              <h2 data-reveal style="--d:1">{p.headline}</h2>
              <p class="svc__desc" data-reveal style="--d:2">{p.description}</p>
              <ul class="svc__dir" data-reveal style="--d:3" aria-label={`${p.label} services`}>
                {serviceDetails[p.key].map((d) => (
                  <li>
                    <a class="svc__sub" href={subServicePath(p.key, d.name)}>
                      <LucideIcon name={d.icon} size={17} />
                      <span>{d.name}</span>
                      <LucideIcon name="ArrowUpRight" size={16} class="svc__go" />
                    </a>
                    {d.children && (
                      <ul class="svc__kids">
                        {d.children.map((c) => (
                          <li><a href={`${subServicePath(p.key, d.name)}${subSlug(c.name)}/`}>{c.name}</a></li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
              <a class="btn btn--outline" href={servicePath(p.key)} data-reveal style="--d:5" data-track="service_card" data-track-label={p.key}>
                {p.cta} <Icon name="arrow" class="arrow" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section theme-dark section--alt flip" data-theme="dark" aria-labelledby="start-title">
    <div class="container">
      <header class="section-head section-head--center head-gap">
        <p class="eyebrow" data-reveal>How We Start</p>
        <h2 id="start-title" class="ph2" data-reveal style="--d:1">From Hello to Growth <span class="accent">in Five Moves.</span></h2>
        <p class="lead" data-reveal style="--d:2">A clear, action-driven path — you’ll always know exactly what happens next.</p>
      </header>
      <StepGrid items={startSteps} />
    </div>
  </section>

  <Tools />

  <PageCTA
    title="Not Sure Where to Start?"
    accent="Start With a Conversation."
    text="Many engagements begin with a single need — a website, a brand or one automation. We’ll help you decide what will move the business first."
    location="services_page"
  />
</Page>

<style>
  .head-gap { margin-bottom: clamp(2.5rem, 5vw, 3.75rem); }
  .svc-list { display: grid; gap: clamp(4rem, 9vw, 7rem); }
  .svc { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; scroll-margin-top: 110px; }
  .svc--rev .svc__media { order: 2; }
  .svc__media { display: block; max-width: 520px; width: 100%; justify-self: center; transition: transform 0.6s var(--ease); }
  .svc__media:hover { transform: translateY(-6px); }
  .svc__text { display: grid; gap: 1.1rem; justify-items: start; }
  .svc__label { display: inline-flex; align-items: center; gap: 0.75rem; font-size: var(--fs-cap); font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-ink); }
  .svc__label span { font-family: var(--font-head); font-weight: 600; letter-spacing: 0.08em; padding-right: 0.75rem; border-right: 1px solid var(--line-light); }
  .svc h2 { font-size: clamp(1.8rem, 1.2rem + 2.2vw, 2.9rem); }
  .svc__desc { color: var(--text-light-muted); font-size: var(--fs-lead); line-height: 1.7; }
  .svc__dir { display: grid; width: 100%; border-top: 1px solid var(--line-light); }
  .svc__dir > li { border-bottom: 1px solid var(--line-light); }
  .svc__sub { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.75rem; padding: 0.8rem 0.25rem; font-family: var(--font-head); font-weight: 600; font-size: 1rem; color: var(--ink); transition: color 0.3s, padding 0.4s var(--ease); }
  .svc__sub:hover { color: var(--gold-ink); padding-left: 0.6rem; }
  .svc__sub :global(svg) { color: var(--gold-ink); }
  .svc__sub :global(.svc__go) { opacity: 0.45; transition: opacity 0.3s, transform 0.4s var(--ease); }
  .svc__sub:hover :global(.svc__go) { opacity: 1; transform: translate(2px, -2px); }
  .svc__kids { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0 0 0.85rem 1.85rem; }
  .svc__kids a { display: inline-block; padding: 0.32rem 0.7rem; border-radius: 999px; font-size: 0.8rem; font-weight: 500; background: rgba(201, 149, 74, 0.08); border: 1px solid rgba(201, 149, 74, 0.22); color: var(--ink); transition: background-color 0.3s, border-color 0.3s; }
  .svc__kids a:hover { background: rgba(201, 149, 74, 0.16); border-color: rgba(201, 149, 74, 0.5); }
  @media (max-width: 900px) {
    .svc { grid-template-columns: 1fr; }
    .svc--rev .svc__media { order: 0; }
  }
</style>
