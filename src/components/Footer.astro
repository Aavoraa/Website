---
import { pillars, site } from '../data/site';
import { servicePath, solutions } from '../data/pages';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
const year = new Date().getFullYear();
---

<footer class="footer theme-dark flip" data-theme="dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="/" aria-label="AAVORAA home">
          <img src="/brand/aavoraa-logo-tagline-gold.png" alt={`AAVORAA — ${site.logoTagline}`} width="1200" height="339" loading="lazy" />
        </a>
        <p>
          An AI-enabled business transformation company helping businesses build, transform and grow through software,
          branding, marketing, automation and business consulting.
        </p>
        <p class="footer__tagline">Build. Transform. Grow.</p>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        <div>
          <h2>Services</h2>
          <ul>
            <li><a href="/services/">All Services</a></li>
            {pillars.map((p) => <li><a href={servicePath(p.key)}>{p.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Solutions</h2>
          <ul>
            {solutions.slice(0, 5).map((x) => <li><a href={`/solutions/#${x.key}`}>{x.title}</a></li>)}
            <li><a href="/industries/">Industries</a></li>
          </ul>
        </div>
        <div>
          <h2>Company</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/approach/">Our Approach</a></li>
            <li><a href="/work/">Our Work</a></li>
            <li><a href="/insights/">Blogs</a></li>
            <li><a href="/faq/">FAQ</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Contact</h2>
          <ul class="footer__contact">
            <li><Icon name="mail" size={16} /><a href={`mailto:${site.contact.email}?subject=${encodeURIComponent("Enquiry from the AAVORAA website")}`}>{site.contact.email}</a></li>
            <li><Icon name="phone" size={16} /><a href={site.contact.phoneHref} aria-label={`Call ${site.contact.phoneDisplay}`}>{site.contact.phoneDisplay}</a></li>
            <li><BrandIcon icon="siWhatsapp" size={16} /><a href={site.contact.whatsappHref} target="_blank" rel="noopener" aria-label={`Chat on WhatsApp: ${site.contact.phoneDisplay}`} data-track="whatsapp" data-track-location="footer">Chat on WhatsApp</a></li>
            <li><Icon name="pin" size={16} /><span>{site.contact.location}</span></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} AAVORAA. All rights reserved.</p>
      <ul>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms & Conditions</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { position: relative; padding: clamp(4rem, 8vw, 6rem) 0 2rem; border-top: 1px solid var(--line-dark); }
  .footer::before {
    content: ''; position: absolute; left: 20%; right: 20%; top: -1px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .footer__top { display: grid; grid-template-columns: minmax(230px, 280px) minmax(0, 1fr); gap: clamp(2.5rem, 4.5vw, 4.5rem); }
  .footer__brand { display: grid; gap: 1.25rem; align-content: start; }
  .footer__brand img { width: 220px; height: auto; }
  .footer__brand p { color: var(--text-dark-muted); font-size: 0.9rem; max-width: 22rem; }
  .footer__tagline { font-family: var(--font-head); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.8rem; color: var(--gold) !important; }
  /* columns size to their longest link (no wrapping) and share the remaining space evenly */
  .footer__cols { display: grid; grid-template-columns: max-content max-content max-content minmax(0, max-content); justify-content: space-between; gap: 2rem clamp(1.5rem, 2.4vw, 2.5rem); }
  .footer__cols h2 { font-family: var(--font-body); font-size: var(--fs-cap); font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 1.1rem; }
  .footer__cols ul { display: grid; gap: 0.85rem; }
  .footer__cols a, .footer__cols span { font-size: 0.875rem; line-height: 1.4; color: var(--text-dark-muted); transition: color 0.3s; white-space: nowrap; }
  .footer__cols a:hover { color: var(--ink); }
  .footer__contact li { display: flex; gap: 0.65rem; align-items: center; }
  .footer__contact span { white-space: normal; max-width: 13rem; } /* the address may wrap */
  .footer__contact li:has(span) { align-items: flex-start; }
  .footer__contact li:has(span) :global(svg) { margin-top: 0.2rem; }
  .footer__contact :global(svg) { flex: none; color: var(--gold); }
  .footer__bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem; border-top: 1px solid var(--line-dark-soft); font-size: 0.8rem; color: var(--text-dark-faint);
  }
  .footer__bottom ul { display: flex; gap: 1.5rem; }
  .footer__bottom a:hover { color: var(--ink); }
  @media (max-width: 1240px) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__brand p { max-width: 34rem; }
  }
  @media (max-width: 900px) {
    .footer__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 2rem; }
  }
  @media (max-width: 640px) {
    .footer__cols a, .footer__cols span { white-space: normal; overflow-wrap: anywhere; }
  }
  @media (max-width: 400px) {
    .footer__cols { grid-template-columns: 1fr; }
  }

  /* ---------- Light theme ---------- */
  :global(:root[data-theme='light']) .footer { background: var(--white); }
  :global(:root[data-theme='light']) .footer__tagline, :global(:root[data-theme='light']) .footer__cols h2 { color: var(--gold-ink) !important; }
  :global(:root[data-theme='light']) .footer__contact :global(svg) { color: var(--gold-ink); }
</style>
