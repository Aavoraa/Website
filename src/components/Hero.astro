---
import Icon from './Icon.astro';
import { bookingHref, bookingIsExternal } from '../data/site';
const ext = bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {};

// Headline words are revealed one by one from behind a mask.
const lines = [
  { words: ['Build', 'Smarter.', 'Transform', 'Faster.'], accent: false },
  { words: ['Grow', 'Further.'], accent: true },
];
let wi = 0;
---

<section class="hero theme-dark flip" data-theme="dark" data-hero aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__art">
      <!-- Static fallback (no WebGL / reduced motion). The live version is drawn on the canvas. -->
      <picture class="only-dark">
        <source media="(max-width: 699px)" srcset="/images/hero-ribbon-mobile.webp" />
        <img src="/images/hero-ribbon.webp" alt="" width="2400" height="1400" decoding="async" />
      </picture>
      <picture class="only-light">
        <source media="(max-width: 699px)" srcset="/images/hero-ribbon-light-mobile.webp" />
        <img src="/images/hero-ribbon-light.webp" alt="" width="2400" height="1400" loading="lazy" decoding="async" />
      </picture>
      <canvas data-hero-canvas></canvas>
      <canvas class="hero__bloom" data-hero-bloom></canvas>
    </div>
    <div class="hero__glow"></div>
    <div class="hero__beam"></div>
  </div>

  <div class="hero__content container">
    <p class="eyebrow hero__eyebrow" style="--h:0">AI-Enabled Business Transformation</p>
    <h1 id="hero-title" aria-label="Build Smarter. Transform Faster. Grow Further.">
      {
        lines.map((l) => (
          <span class="line" aria-hidden="true">
            {l.words.map((w) => (
              <span class="w">
                <span class:list={['w__i', { accent: l.accent }]} style={`--w:${wi++}`}>{w}</span>
              </span>
            ))}
          </span>
        ))
      }
    </h1>
    <p class="hero__copy lead" style="--h:5">
      AAVORAA brings software, branding, marketing and automation together to help businesses build better digital
      experiences, streamline operations and unlock new growth opportunities.
    </p>
    <div class="hero__ctas" style="--h:6">
      <a class="btn hero__primary" data-magnetic href={bookingHref} data-track="cta_primary" data-track-location="hero" {...ext}>
        Book a Discovery Call <Icon name="arrow" class="arrow" />
      </a>
      <a class="btn btn--ghost" data-magnetic href="#solutions" data-track="cta_secondary" data-track-location="hero">Explore Our Solutions</a>
    </div>
    <p class="hero__micro caption" style="--h:7">For ambitious businesses ready to connect technology, operations and growth.</p>
  </div>

  <a class="hero__scroll" href="#services" aria-label="Scroll to our capabilities">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: max(640px, min(100svh, 980px));
    display: flex; align-items: flex-start;
    padding-top: clamp(8.5rem, 18vh, 11.5rem);
    padding-bottom: clamp(14rem, 30vh, 20rem);
  }
  .hero__bg { position: absolute; inset: 0; z-index: -1; background: var(--black); }

  /* The art layer responds to scroll (set by main.ts) */
  .hero__art {
    position: absolute; inset: 0;
    transform-origin: 50% 100%;
    transform: translate3d(0, calc(var(--hero-p, 0) * 10%), 0) scale(calc(1.02 + var(--hero-p, 0) * 0.1));
    opacity: calc(1 - clamp(0, (var(--hero-p, 0) - 0.35) / 0.5, 1));
    will-change: transform, opacity;
  }
  .hero__art picture, .hero__art img, .hero__art canvas {
    position: absolute; inset: 0; width: 100%; height: 100%; display: block;
  }
  .hero__art img { object-fit: cover; object-position: 50% 100%; }
  .hero__art canvas { opacity: 0; transition: opacity 0.6s var(--ease); }
  .hero__art .hero__bloom { mix-blend-mode: screen; filter: brightness(1.5); }

  /* With JS the static image waits for the live canvas; it returns if WebGL is unavailable. */
  :global(.js) .hero:not(.no-gl) .hero__art picture { opacity: 0; }
  :global(.gl-live) .hero__art canvas { opacity: 1; }
  :global(.gl-live) .hero__art .hero__bloom { opacity: 0.6; }
  :global(.no-gl) .hero__art canvas { display: none; }
  :global(.no-gl) .hero__art picture { opacity: 1; animation: hero-fade 1.6s var(--ease) both; }
  @keyframes hero-fade { from { opacity: 0; transform: scale(1.04); } }

  .hero__glow {
    position: absolute; left: 50%; bottom: -18%; width: 70vmax; height: 50vmax; translate: -50% 0;
    background: radial-gradient(closest-side, rgba(201, 149, 74, 0.3), rgba(201, 149, 74, 0.07) 55%, transparent 75%);
    mix-blend-mode: screen;
    animation: glow-drift 14s var(--ease-soft) infinite alternate;
  }
  @keyframes glow-drift {
    from { transform: translateX(-6%) scale(0.95); opacity: 0.7; }
    to { transform: translateX(6%) scale(1.05); opacity: 1; }
  }
  .hero__beam { /* dark veil behind the text keeps the headline instantly readable */
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 52% 50% at 50% 34%, rgba(10, 9, 9, 0.82), rgba(10, 9, 9, 0.4) 55%, transparent 78%),
      linear-gradient(to bottom, rgba(10, 9, 9, 0.6), transparent 35%, transparent 78%, rgba(10, 9, 9, 0.6) 91%, var(--black) 100%);
  }

  /* ---------- Content entrance ---------- */
  .hero__content { display: grid; justify-items: center; text-align: center; gap: 1.5rem; }
  .hero__content > :not(h1) { animation: hero-in 1.2s var(--ease) backwards; animation-delay: calc(var(--h) * 110ms + 200ms); }
  @keyframes hero-in { from { opacity: 0; transform: translateY(24px); filter: blur(6px); } }

  .hero__eyebrow {
    padding: 0.45rem 0.95rem; border-radius: 999px;
    background: rgba(201, 149, 74, 0.08); border: 1px solid rgba(201, 149, 74, 0.25);
    backdrop-filter: blur(6px);
  }

  h1 { font-size: clamp(2.1rem, 1.1rem + 3.3vw, 3.6rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.08; max-width: 16em; }
  h1 .line { display: block; }
  /* word mask reveal */
  .w { display: inline-block; overflow: hidden; vertical-align: top; padding: 0.04em 0.06em 0.1em; margin: -0.04em -0.06em -0.1em; }
  .w + .w { margin-left: 0.2em; }
  .w__i {
    display: inline-block;
    animation: word-in 1.1s var(--ease) backwards;
    animation-delay: calc(var(--w) * 85ms + 380ms);
  }
  @keyframes word-in {
    from { transform: translateY(110%) rotate(4deg); opacity: 0; }
    60% { opacity: 1; }
  }
  /* gold words keep the metallic sheen after they land */
  .w__i.accent { animation: word-in 1.1s var(--ease) backwards, sheen 9s var(--ease-soft) 1.6s infinite; animation-delay: calc(var(--w) * 85ms + 380ms), 1.6s; }

  .hero__copy { max-width: 36rem; font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem); color: rgba(255, 255, 255, 0.74); }
  .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
  .hero__micro { color: rgba(255, 255, 255, 0.6); text-shadow: 0 1px 12px rgba(10, 9, 9, 0.9); }

  /* soft halo that pulses around the primary CTA */
  .hero__primary { animation: halo 3.2s var(--ease-soft) 2.4s infinite; }
  .hero__primary:hover, .hero__primary:focus-visible { animation: none; }
  @keyframes halo {
    0% { box-shadow: 0 0 0 0 rgba(201, 149, 74, 0.5); }
    70%, 100% { box-shadow: 0 0 0 14px rgba(201, 149, 74, 0); }
  }

  /* ---------- Interaction: depth parallax + magnetic CTAs (vars set by hero-wave.ts) ---------- */
  .hero__content { transform: translate3d(calc(var(--mx, 0) * -10px), calc(var(--my, 0) * -6px), 0); }
  h1 { transform: translate3d(calc(var(--mx, 0) * -6px), calc(var(--my, 0) * -4px), 0); }
  [data-magnetic] { translate: var(--tx, 0px) var(--ty, 0px); transition: translate 0.5s var(--ease), transform 0.45s var(--ease), box-shadow 0.45s var(--ease), background-color 0.3s, color 0.3s, border-color 0.3s; }


  .hero__scroll {
    position: absolute; left: 50%; bottom: 28px; translate: -50% 0;
    width: 26px; height: 42px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.22);
    display: grid; justify-items: center; padding-top: 8px;
    animation: hero-in 1.2s var(--ease) 1.6s backwards;
  }
  .hero__scroll span { width: 3px; height: 8px; border-radius: 2px; background: var(--gold); animation: scroll-dot 2.2s var(--ease) infinite; }
  @keyframes scroll-dot { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }

  @media (max-width: 699px) {
    .hero { padding-top: 7.5rem; padding-bottom: 13rem; min-height: 100svh; }
    .hero__ctas { flex-direction: column; width: 100%; }
    .hero__ctas .btn { width: 100%; }
    .hero__scroll { display: none; }
    .hero__eyebrow { letter-spacing: 0.08em; font-size: 0.66rem; padding: 0.4rem 0.8rem; gap: 0.45rem; white-space: nowrap; }
  }

  /* ---------- Light theme: gold ink on Soft Ivory ---------- */
  :global(:root[data-theme='light']) .hero__bg { background: var(--ivory); }
  :global(:root[data-theme='light']) .hero__art .hero__bloom { mix-blend-mode: multiply; filter: none; }
  :global(:root[data-theme='light']) :global(.gl-live) .hero__art .hero__bloom { opacity: 0.08; }
  :global(:root[data-theme='light']) .hero__glow {
    mix-blend-mode: multiply;
    background: radial-gradient(closest-side, rgba(201, 149, 74, 0.16), rgba(201, 149, 74, 0.05) 55%, transparent 75%);
  }
  :global(:root[data-theme='light']) .hero__beam {
    background:
      radial-gradient(ellipse 52% 50% at 50% 34%, rgba(244, 240, 232, 0.88), rgba(244, 240, 232, 0.45) 55%, transparent 78%),
      linear-gradient(to bottom, rgba(244, 240, 232, 0.6), transparent 35%, transparent 78%, rgba(244, 240, 232, 0.6) 91%, var(--ivory) 100%);
  }
  :global(:root[data-theme='light']) .hero__eyebrow { background: rgba(201, 149, 74, 0.1); border-color: rgba(138, 92, 36, 0.3); }
  :global(:root[data-theme='light']) .hero__copy { color: rgba(10, 9, 9, 0.72); }
  :global(:root[data-theme='light']) .hero__micro { color: rgba(10, 9, 9, 0.6); text-shadow: 0 1px 12px rgba(244, 240, 232, 0.9); }
  :global(:root[data-theme='light']) .hero__scroll { border-color: rgba(10, 9, 9, 0.22); }
</style>
