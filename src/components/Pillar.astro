---
import Icon from './Icon.astro';
import PillarVisual from './PillarVisual.astro';
import LucideIcon from './LucideIcon.astro';
import { pillars, type PillarKey } from '../data/site';
import { servicePath } from '../data/pages';

interface Props {
  kind: PillarKey;
  alt?: boolean;  // lifted-black alternate surface
  flip?: boolean; // becomes light in the light theme
  reverse?: boolean;
  first?: boolean;
}
const { kind, alt = false, flip = false, reverse = false, first = false } = Astro.props;
const index = pillars.findIndex((p) => p.key === kind);
const p = pillars[index];

// Selective emphasis: the last two words of the headline carry the gold accent.
const words = p.headline.split(' ');
const lead = words.slice(0, -2).join(' ');
const tail = words.slice(-2).join(' ');
---

<section
  class:list={['pillar', 'section', 'theme-dark', { 'section--alt': alt, flip, 'pillar--reverse': reverse, 'pillar--first': first }]}
  id={`pillar-${kind}`}
  data-theme="dark"
  data-inview
  aria-labelledby={`pillar-${kind}-title`}
>
  <div class="container pillar__grid">
    <div class="pillar__text">
      <p class="pillar__label" data-reveal>
        <span class="pillar__index">0{index + 1}</span>
        <span class="pillar__rule" aria-hidden="true"></span>
        <span class="pillar__name"><Icon name={kind} size={16} /> {p.label}</span>
      </p>
      <h2 id={`pillar-${kind}-title`} data-reveal style="--d:1">{lead} <span class="accent">{tail}</span></h2>
      <p class="lead" data-reveal style="--d:2">{p.description}</p>

      <ul class="pillar__caps" aria-label={`${p.label} capabilities`}>
        {
          p.capabilities.map((c, i) => (
            <li data-reveal style={`--d:${i + 2}`}>
              <span class="pillar__cap-icon"><LucideIcon name={c.icon} size={17} /></span>
              {c.name}
            </li>
          ))
        }
      </ul>

      <a
        class:list={['btn', 'btn--outline', 'pillar__cta']}
        href={servicePath(kind)}
        data-track="service_card"
        data-track-label={`pillar_${kind}`}
        data-reveal
        style="--d:4"
      >
        {p.cta} <Icon name="arrow" class="arrow" />
      </a>
    </div>

    <div class="pillar__visual" data-reveal="scale" style="--d:1">
      <div class="pillar__frame">
        <span class="pillar__frame-label" aria-hidden="true" style={`--chars:${p.visual.length}`}>{p.visual}</span>
        <PillarVisual kind={kind} />
      </div>
    </div>
  </div>
</section>

<style>
  .pillar { overflow: hidden; }
  .pillar--first { padding-top: clamp(4rem, 8vw, 8rem); }
  .pillar__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(2.5rem, 7vw, 7rem); }
  .pillar--reverse .pillar__text { order: 2; }

  .pillar__text { display: grid; gap: 1.5rem; justify-items: start; }
  .pillar__label { display: flex; align-items: center; gap: 0.9rem; font-size: var(--fs-cap); font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; }
  .pillar__index { font-family: var(--font-head); font-weight: 600; letter-spacing: 0.08em; color: var(--gold-ink); }
  .pillar__rule { width: 48px; height: 1px; background: currentColor; opacity: 0.3; }
  .pillar__name { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--gold-ink); }

  .pillar h2 { font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem); max-width: 12em; }

  .pillar__caps {
    display: grid; grid-template-columns: 1fr 1fr; width: 100%; margin-top: 0.5rem;
    border-top: 1px solid var(--line-light);
  }
  .pillar__caps li {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.5rem 0.7rem 0;
    border-bottom: 1px solid var(--line-light); font-size: 0.9375rem; font-weight: 500;
  }
  .pillar__caps li { color: var(--ink); }
  .pillar__cap-icon {
    flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px;
    color: var(--gold-ink); background: rgba(201, 149, 74, 0.1); border: 1px solid rgba(201, 149, 74, 0.22);
    transition: background-color 0.3s, color 0.3s;
  }
  .pillar__caps li:hover .pillar__cap-icon { background: var(--gold); color: var(--black); }
  .pillar__cta { margin-top: 0.75rem; }

  .pillar__visual { position: relative; }
  .pillar__frame {
    position: relative; aspect-ratio: 1; border-radius: 36px; padding: clamp(1.5rem, 4vw, 3rem);
    display: grid; place-items: center; container-type: inline-size;
    color: var(--ink);
    background: var(--frame-bg);
    border: 1px solid var(--frame-line);
    box-shadow: 0 50px 90px -50px var(--shadow), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .pillar__frame-label {
    position: absolute; top: 1.4rem; left: 1.6rem; right: 1.6rem; white-space: nowrap; overflow: hidden;
    font-family: var(--font-head); font-weight: 700; letter-spacing: -0.05em; line-height: 0.8;
    /* shrink long words (e.g. TRANSFORM) so they always sit inside the frame */
    font-size: min(clamp(3rem, 2rem + 4vw, 6rem), calc((100cqi - 3.2rem) / (var(--chars) * 0.57)));
    color: transparent; -webkit-text-stroke: 1px var(--frame-label);
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .pillar__grid { grid-template-columns: 1fr; }
    .pillar--reverse .pillar__text { order: 0; }
    .pillar__visual { max-width: 520px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 520px) {
    .pillar__caps { grid-template-columns: 1fr; }
    .pillar__cta { width: 100%; white-space: normal; text-align: center; }
  }
</style>
