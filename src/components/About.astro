---
import LucideIcon from './LucideIcon.astro';
import { stats, aboutFacts, site } from '../data/site';
---

<section class="about section theme-dark section--alt flip" id="about" data-theme="dark" aria-labelledby="about-title">
  <div class="container">
    <header class="about__head">
      <p class="eyebrow" data-reveal>About AAVORAA</p>
      <h2 id="about-title" data-reveal style="--d:1">One Team. <span class="accent">Every Digital Capability.</span></h2>
      <p class="lead" data-reveal style="--d:2">
        A business transformation partner bringing strategy, technology, branding and growth together — so you never juggle vendors again.
      </p>
    </header>

    <ul class="about__stats">
      {
        stats.map((s, i) => (
          <li class="stat" data-reveal style={`--d:${i}`}>
            <span class="stat__icon"><LucideIcon name={s.icon} size={22} /></span>
            <span class="stat__value">
              <span data-count={s.value}>{s.value}</span>{s.suffix}
            </span>
            <span class="stat__label">{s.label}</span>
          </li>
        ))
      }
    </ul>

    <ul class="about__facts" data-reveal>
      {aboutFacts.map((f) => <li><LucideIcon name={f.icon} size={16} />{f.text}</li>)}
    </ul>
    <p class="sr-only">{site.summary}</p>
  </div>
</section>

<style>
  .about__head { display: grid; justify-items: center; text-align: center; gap: 1.1rem; max-width: 46rem; margin: 0 auto clamp(3rem, 6vw, 4.5rem); }
  .about__head h2 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem); }
  .about__head h2 .accent { display: block; }

  .about__stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.75rem, 1.4vw, 1.1rem); }
  .stat {
    position: relative; display: grid; gap: 0.5rem; justify-items: start; padding: 1.4rem 1.25rem 1.3rem;
    border-radius: var(--radius-md); background: var(--surface); border: 1px solid var(--surface-line);
    transition: transform 0.6s var(--ease), border-color 0.4s, box-shadow 0.6s var(--ease);
  }
  .stat:hover { transform: translateY(-4px); border-color: rgba(201, 149, 74, 0.4); box-shadow: 0 20px 40px -28px var(--shadow); }
  /* cursor spotlight extras: the icon and number light up */
  .stat__icon, .stat__value { transition: color 0.4s, background-color 0.4s, box-shadow 0.4s, text-shadow 0.4s; }
  .stat:hover .stat__icon { color: #ffe2aa; background: rgba(201, 149, 74, 0.28); box-shadow: 0 0 22px -2px rgba(240, 190, 110, 0.75); }
  .stat:hover .stat__value { color: #fff4dd; text-shadow: 0 0 24px rgba(240, 190, 110, 0.65); }
  :global(:root[data-theme='light']) .stat:hover .stat__value { color: var(--gold-deep); text-shadow: none; }
  .stat__icon {
    display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; margin-bottom: 0.4rem;
    color: var(--gold-ink); background: rgba(201, 149, 74, 0.1); border: 1px solid rgba(201, 149, 74, 0.25);
  }
  .stat__value { font-family: var(--font-head); font-weight: 600; font-size: clamp(2rem, 1.4rem + 1.6vw, 2.8rem); line-height: 1; letter-spacing: -0.03em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stat__label { font-size: 0.85rem; color: var(--text-light-muted); line-height: 1.35; }

  .about__facts { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem 1.75rem; margin-top: clamp(2rem, 4vw, 3rem); }
  /* fact chips get the cursor spotlight (motion.ts) and glow on hover */
  .about__facts li {
    position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.6rem 1.1rem; border-radius: 999px; font-size: 0.9rem; color: var(--text-light-muted);
    background: var(--surface); border: 1px solid var(--surface-line);
    transition: color 0.35s, border-color 0.35s, transform 0.4s var(--ease), box-shadow 0.4s var(--ease), text-shadow 0.35s;
  }
  .about__facts li:hover { color: #fff4dd; border-color: rgba(226, 189, 132, 0.6); transform: translateY(-2px); box-shadow: 0 0 26px -6px rgba(240, 190, 110, 0.55); text-shadow: 0 0 14px rgba(240, 190, 110, 0.6); }
  .about__facts :global(svg) { position: relative; z-index: 1; color: var(--gold-ink); transition: filter 0.35s, color 0.35s; }
  .about__facts li:hover :global(svg) { color: #ffe2aa; filter: drop-shadow(0 0 6px rgba(240, 190, 110, 0.9)); }
  :global(:root[data-theme='light']) .about__facts li:hover { color: var(--gold-deep); text-shadow: none; }

  @media (max-width: 1000px) { .about__stats { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .about__stats { grid-template-columns: repeat(2, 1fr); } }
</style>
