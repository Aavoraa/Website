---
import Icon from './Icon.astro';
import LucideIcon from './LucideIcon.astro';
import { nav, bookingHref, bookingIsExternal, site, pillars } from '../data/site';
import { serviceDetails, servicePath, subServicePath, subSlug } from '../data/pages';
// Services dropdown: every service with its sub-services (and their specialist services)
const menu = pillars.map((p) => ({
  label: p.label,
  href: servicePath(p.key),
  subs: serviceDetails[p.key].map((d) => ({
    name: d.name,
    href: subServicePath(p.key, d.name),
    children: (d.children || []).map((c) => ({ name: c.name, href: `${subServicePath(p.key, d.name)}${subSlug(c.name)}/` })),
  })),
}));
const pillarIcon: Record<string, string> = { build: 'CodeXml', brand: 'Palette', grow: 'Megaphone', transform: 'Workflow' };
const menuIcons = pillars.map((p) => pillarIcon[p.key]);
const ext = bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {};
// highlight the section of the site the visitor is in (e.g. /work/kpr-mill/ → Our Work)
const here = (href: string) => (href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href));
---

<header class="nav" data-nav data-nav-theme="dark">
  <div class="nav__pill">
    <a class="nav__logo" href="/" aria-label={`AAVORAA — ${site.logoTagline} — home`}>
      <!-- Full-colour logo on dark surfaces, monochrome black on light (per brand guidelines) -->
      <img class="logo-on-dark" src="/brand/aavoraa-logo-gold.png" alt="" width="900" height="254" />
      <img class="logo-on-light" src="/brand/aavoraa-logo-black.png" alt="" aria-hidden="true" width="900" height="254" />
      <!-- Tagline sits where the lockup places it (under the wordmark); live text so it stays legible -->
      <span class="nav__tagline" aria-hidden="true">{site.logoTagline}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {nav.map((item) =>
          item.href === '/services/' ? (
            <li class="nav__has-menu">
              <a href={item.href} data-nav-link aria-haspopup="true" class:list={{ 'is-current': here(item.href) }} aria-current={here(item.href) ? 'page' : undefined}>
                {item.label} <LucideIcon name="ChevronDown" size={14} class="nav__caret" />
              </a>
              <div class="nav__menu" role="group" aria-label="Services">
                <div class="nav__menu-grid">
                  {menu.map((m, i) => (
                    <div class="nav__menu-col">
                      <a class="nav__menu-head" href={m.href} aria-haspopup="true">
                        <span class="nav__menu-ico"><LucideIcon name={menuIcons[i]} size={14} /></span>
                        <span class="nav__menu-label">{m.label}</span>
                        <LucideIcon name="ChevronRight" size={14} class="nav__head-caret" />
                      </a>
                      <div class="nav__menu-subs-wrap">
                      <ul class="nav__menu-subs">
                        {m.subs.map((s) => (
                          <li class:list={{ 'nav__menu-parent': s.children.length > 0 }}>
                            <a href={s.href} aria-haspopup={s.children.length > 0 ? 'true' : undefined}>
                              {s.name}{s.children.length > 0 && <LucideIcon name="ChevronRight" size={13} class="nav__sub-caret" />}
                            </a>
                            {s.children.length > 0 && (
                              <div class="nav__menu-kids-wrap">
                                <ul class="nav__menu-kids">{s.children.map((c) => <li><a href={c.href}>{c.name}</a></li>)}</ul>
                              </div>
                            )}
                          </li>
                        ))}
                      </ul>
                      </div>
                    </div>
                  ))}
                </div>
                <a class="nav__menu-all" href="/services/">View all services <LucideIcon name="ArrowRight" size={13} /></a>
              </div>
            </li>
          ) : (
            <li><a href={item.href} data-nav-link class:list={{ 'is-current': here(item.href) }} aria-current={here(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ),
        )}
      </ul>
    </nav>

    <button class="nav__theme" type="button" data-theme-toggle aria-pressed="false">
      <span class="sr-only" data-theme-label>Switch to light theme</span>
      <Icon name="sun" size={18} class="i-sun" />
      <Icon name="moon" size={18} class="i-moon" />
    </button>

    <a class="btn btn--sm nav__cta" href={bookingHref} data-track="cta_primary" data-track-location="nav" {...ext}>
      Book a Discovery Call
    </a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only">Open menu</span>
      <Icon name="menu" class="i-open" />
      <Icon name="close" class="i-close" />
    </button>
  </div>

  <div class="nav__panel" id="mobile-menu" data-menu hidden>
    <ul>
      {nav.map((item, i) => (
        <li style={`--i:${i}`}><a href={item.href} data-menu-link>{item.label}<Icon name="arrow" size={18} /></a></li>
      ))}
    </ul>
    <a class="btn nav__panel-cta" href={bookingHref} data-track="cta_primary" data-track-location="mobile_menu" data-menu-link {...ext}>
      Book a Discovery Call <Icon name="arrow" class="arrow" />
    </a>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 14px 0 auto; z-index: 100;
    display: flex; flex-direction: column; align-items: center;
    padding-inline: clamp(12px, 2vw, 28px); pointer-events: none;
  }
  .nav__pill {
    pointer-events: auto;
    display: flex; align-items: center; gap: 1.25rem;
    width: 100%; height: var(--nav-h);
    padding: 0 10px 0 22px; border-radius: 999px;
    background: rgba(18, 16, 16, 0.62);
    border: 1px solid rgba(201, 149, 74, 0.22);
    box-shadow: 0 10px 40px -12px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    transition: background-color 0.5s var(--ease), border-color 0.5s var(--ease), box-shadow 0.5s var(--ease), width 0.6s var(--ease), height 0.6s var(--ease);
  }
  .nav.is-scrolled .nav__pill { height: 58px; }
  .nav[data-nav-theme='light'] .nav__pill {
    background: rgba(255, 255, 255, 0.82);
    border-color: rgba(10, 9, 9, 0.08);
    box-shadow: 0 10px 34px -14px rgba(10, 9, 9, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .nav__logo { position: relative; display: block; flex: none; width: 172px; --logo-w: 172px; }
  .nav__logo img { width: 100%; height: auto; transition: opacity 0.4s var(--ease); }
  .nav__logo .logo-on-light { position: absolute; inset: 0; opacity: 0; }
  .nav[data-nav-theme='light'] .logo-on-dark { opacity: 0; }
  .nav[data-nav-theme='light'] .logo-on-light { opacity: 1; }
  .nav__tagline {
    position: absolute; left: 41.5%; right: 0; top: 60%;
    font-family: var(--font-body); font-weight: 500; text-transform: uppercase; white-space: nowrap;
    font-size: calc(var(--logo-w) * 0.0415); letter-spacing: 0.06em; line-height: 1;
    background: linear-gradient(90deg, #b0742c, #cc9e5c); -webkit-background-clip: text; background-clip: text; color: transparent;
    transition: opacity 0.4s var(--ease);
  }
  .nav[data-nav-theme='light'] .nav__tagline { background: none; color: rgba(10, 9, 9, 0.8); }

  .nav__links { margin-inline: auto; }
  .nav__links > ul { display: flex; gap: 0.25rem; }
  .nav__links a {
    position: relative; display: block; padding: 0.5rem 0.8rem; border-radius: 999px; white-space: nowrap;
    font-size: 0.875rem; font-weight: 500; color: var(--text-dark-muted);
    transition: color 0.3s, background-color 0.3s;
  }
  .nav__links a:hover { color: var(--white); background: rgba(255, 255, 255, 0.06); }
  .nav__links a.is-active, .nav__links a.is-current { color: var(--white); }
  .nav__links a.is-active::after, .nav__links a.is-current::after {
    content: ''; position: absolute; left: 50%; bottom: 3px; width: 4px; height: 4px; margin-left: -2px;
    border-radius: 50%; background: var(--gold);
  }
  .nav[data-nav-theme='light'] .nav__links a { color: rgba(10, 9, 9, 0.66); }
  .nav[data-nav-theme='light'] .nav__links a:hover,
  .nav[data-nav-theme='light'] .nav__links a.is-active,
  .nav[data-nav-theme='light'] .nav__links a.is-current { color: var(--black); background: rgba(10, 9, 9, 0.05); }
  .nav[data-nav-theme='light'] .nav__links a.is-active::after,
  .nav[data-nav-theme='light'] .nav__links a.is-current::after { background: var(--gold-ink); }

  .nav__cta { flex: none; }

  /* ---------- Services dropdown (opens on hover or keyboard focus) ---------- */
  .nav__pill { position: relative; }
  /* the Services item fills the bar's height so moving down into the dropdown never leaves it */
  .nav__links { align-self: stretch; display: flex; align-items: center; }
  .nav__links > ul { height: 100%; align-items: center; }
  .nav__has-menu { align-self: stretch; display: flex; align-items: center; }
  .nav__has-menu > a { display: inline-flex; align-items: center; gap: 0.3rem; }
  .nav__has-menu :global(.nav__caret) { transition: transform 0.3s var(--ease); opacity: 0.7; }
  .nav__has-menu:hover :global(.nav__caret), .nav__has-menu:focus-within :global(.nav__caret) { transform: rotate(180deg); opacity: 1; }
  /* side (cascading) dropdown: services → sub-services → specialist services, each opening to the right */
  .nav__has-menu { position: relative; }
  .nav__menu {
    position: absolute; left: -0.4rem; top: 100%; width: max-content; min-width: 250px; padding-top: 8px; /* the gap keeps hover alive */
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.22s var(--ease), transform 0.28s var(--ease), visibility 0s linear 0.22s;
  }
  .nav__has-menu:hover .nav__menu, .nav__has-menu:focus-within .nav__menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .nav__menu-grid, .nav__menu-subs, .nav__menu-kids {
    display: grid; gap: 0.1rem; padding: 0.45rem; margin: 0;
    background: #110f0e; border: 1px solid rgba(201, 149, 74, 0.25); border-radius: 14px;
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.85);
  }
  .nav__menu-grid { border-radius: 14px 14px 0 0; border-bottom: 0; }
  .nav__menu-col, .nav__menu-parent { position: relative; }

  .nav__links .nav__menu a { display: flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0.6rem; border-radius: 9px; background: none; white-space: nowrap; }
  .nav__links .nav__menu a::after { display: none; }
  .nav__links .nav__menu .nav__menu-head { font-family: var(--font-head); font-size: 0.84rem; font-weight: 600; color: var(--white); }
  .nav__menu-label { flex: 1; }
  .nav__menu-ico { flex: none; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; color: var(--gold); background: rgba(201, 149, 74, 0.12); border: 1px solid rgba(201, 149, 74, 0.25); transition: background 0.25s, color 0.25s; }
  .nav__links .nav__menu-subs a, .nav__links .nav__menu-kids a { font-size: 0.8rem; font-weight: 500; color: var(--text-dark-muted); }

  /* the hovered row lights up */
  .nav__menu-col:hover > .nav__menu-head, .nav__menu-col:focus-within > .nav__menu-head,
  .nav__menu-subs li:hover > a, .nav__menu-kids li:hover > a, .nav__menu-subs a:focus-visible, .nav__menu-kids a:focus-visible {
    background: rgba(201, 149, 74, 0.12); color: var(--gold-light);
  }
  .nav__menu-col:hover .nav__menu-ico, .nav__menu-col:focus-within .nav__menu-ico { background: var(--gold); color: #0a0909; border-color: var(--gold); }
  :is(.nav__menu-head, .nav__menu-parent > a) > :global(svg:last-child) { flex: none; margin-left: auto; padding-left: 0.6rem; box-sizing: content-box; opacity: 0.55; transition: transform 0.25s var(--ease), opacity 0.25s, color 0.25s; }
  :is(.nav__menu-col:hover > .nav__menu-head, .nav__menu-parent:hover > a) > :global(svg:last-child) { opacity: 1; color: var(--gold); transform: translateX(2px); }

  /* flyouts: open beside the hovered row (padding-left bridges the gap so hover isn't lost) */
  .nav__menu-subs-wrap, .nav__menu-kids-wrap {
    position: absolute; left: 100%; top: -0.45rem; padding-left: 0.5rem; width: max-content; min-width: 220px; z-index: 1;
    opacity: 0; visibility: hidden; transform: translateX(-6px);
    transition: opacity 0.2s var(--ease), transform 0.25s var(--ease), visibility 0s linear 0.2s;
  }
  .nav__menu-col:hover > .nav__menu-subs-wrap, .nav__menu-col:focus-within > .nav__menu-subs-wrap,
  .nav__menu-parent:hover > .nav__menu-kids-wrap, .nav__menu-parent:focus-within > .nav__menu-kids-wrap {
    opacity: 1; visibility: visible; transform: none; transition-delay: 0s;
  }

  .nav__links .nav__menu .nav__menu-all {
    justify-content: center; gap: 0.35rem; padding: 0.55rem; border-radius: 0 0 14px 14px;
    font-size: 0.76rem; font-weight: 600; color: var(--gold);
    background: #1b1612; border: 1px solid rgba(201, 149, 74, 0.25);
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.85);
  }
  .nav__links .nav__menu .nav__menu-all:hover { background: var(--gold); color: var(--black); }
  :global(:root[data-theme='light']) :is(.nav__menu-grid, .nav__menu-subs, .nav__menu-kids) { background: #ffffff; border-color: rgba(10, 9, 9, 0.08); box-shadow: 0 24px 50px -24px rgba(10, 9, 9, 0.35); }
  :global(:root[data-theme='light']) .nav__links .nav__menu .nav__menu-head { color: var(--black); }
  :global(:root[data-theme='light']) .nav__links :is(.nav__menu-subs, .nav__menu-kids) a { color: rgba(10, 9, 9, 0.72); }
  :global(:root[data-theme='light']) :is(.nav__menu-col:hover > .nav__menu-head, .nav__menu-subs li:hover > a, .nav__menu-kids li:hover > a) { background: rgba(201, 149, 74, 0.12); color: var(--gold-deep); }
  :global(:root[data-theme='light']) .nav__links .nav__menu .nav__menu-all { color: var(--gold-deep); border-color: rgba(10, 9, 9, 0.08); background: #f7f1e6; }

  /* theme toggle */
  .nav__theme {
    flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    color: var(--gold); border: 1px solid rgba(201, 149, 74, 0.3);
    transition: background-color 0.3s, border-color 0.3s, transform 0.5s var(--ease);
  }
  .nav__theme:hover { background: rgba(201, 149, 74, 0.12); border-color: var(--gold); }
  .nav__theme :global(svg) { grid-area: 1 / 1; transition: transform 0.6s var(--ease), opacity 0.4s; }
  .nav__theme :global(.i-moon) { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  :global(:root[data-theme='light']) .nav__theme :global(.i-sun) { opacity: 0; transform: rotate(90deg) scale(0.6); }
  :global(:root[data-theme='light']) .nav__theme :global(.i-moon) { opacity: 1; transform: none; }
  .nav[data-nav-theme='light'] .nav__theme { color: var(--gold-deep); border-color: rgba(10, 9, 9, 0.15); }
  .nav__toggle {
    display: none; width: 44px; height: 44px; border-radius: 50%; place-items: center; color: var(--white);
    transition: background-color 0.3s, color 0.3s;
  }
  .nav__toggle:hover { background: rgba(255, 255, 255, 0.08); }
  .nav[data-nav-theme='light'] .nav__toggle { color: var(--black); }
  .nav__toggle :global(.i-close) { display: none; }
  .nav__toggle[aria-expanded='true'] :global(.i-open) { display: none; }
  .nav__toggle[aria-expanded='true'] :global(.i-close) { display: block; }

  .nav__panel {
    pointer-events: auto;
    width: 100%; margin-top: 8px; padding: 0.75rem;
    border-radius: 26px; background: rgba(14, 12, 12, 0.94);
    border: 1px solid rgba(201, 149, 74, 0.2);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
    transform-origin: top center;
    animation: panel-in 0.45s var(--ease);
  }
  .nav__panel[hidden] { display: none; }
  .nav__panel li { animation: item-in 0.5s var(--ease) backwards; animation-delay: calc(var(--i) * 40ms + 60ms); }
  .nav__panel li a {
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.95rem 1rem; color: var(--white); font-family: var(--font-head); font-size: 1.25rem; font-weight: 600;
    border-bottom: 1px solid var(--line-dark-soft);
  }
  .nav__panel li a :global(svg) { color: var(--gold); }
  .nav__panel-cta { width: 100%; margin-top: 0.85rem; }
  @keyframes panel-in { from { opacity: 0; transform: translateY(-8px) scale(0.98); } }
  @keyframes item-in { from { opacity: 0; transform: translateY(6px); } }

  @media (max-width: 1320px) {
    .nav__links a { padding-inline: 0.6rem; }
  }
  /* seven links + CTA need ~1180px; below that use the menu button */
  @media (max-width: 1180px) {
    .nav__links { display: none; }
    .nav__theme { margin-left: auto; }
    .nav__cta { margin-left: 0; }
    .nav__toggle { display: grid; }
  }
  @media (max-width: 520px) {
    .nav { inset-block-start: 10px; }
    .nav__pill { padding-left: 18px; gap: 0.5rem; }
    .nav__logo { width: 160px; --logo-w: 160px; }
    .nav__tagline { letter-spacing: 0.04em; }
    .nav__cta { display: none; }
    .nav__toggle { margin-left: 0; }
  }

  :global(:root[data-theme='light']) .nav__panel { background: rgba(255, 255, 255, 0.97); border-color: rgba(10, 9, 9, 0.08); box-shadow: 0 30px 60px -24px rgba(10, 9, 9, 0.3); }
  :global(:root[data-theme='light']) .nav__panel li a { color: var(--black); border-color: rgba(10, 9, 9, 0.08); }
  :global(:root[data-theme='light']) .nav__panel li a :global(svg) { color: var(--gold-ink); }
</style>
