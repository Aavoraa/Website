---
import LucideIcon from './LucideIcon.astro';
import { industries } from '../data/site';
---

<section class="ind section theme-dark flip" id="industries" data-theme="dark" aria-labelledby="ind-title">
  <div class="container">
    <header class="section-head section-head--center">
      <p class="eyebrow" data-reveal>Industries &amp; Fields</p>
      <h2 id="ind-title" data-reveal style="--d:1">Built Around the Way <span class="accent">Your Business Works.</span></h2>
    </header>

    <ul class="ind__grid">
      {
        industries.map((it, i) => (
          <li class="ind__tile" data-reveal style={`--d:${i % 4}`}>
            <span class="ind__icon"><LucideIcon name={it.icon} size={24} /></span>
            <span class="ind__name">{it.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ind .section-head { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .ind__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(0.6rem, 1.2vw, 1rem); }
  .ind__tile {
    display: flex; align-items: center; gap: 0.9rem; padding: 1.05rem 1.15rem; border-radius: 16px;
    background: var(--surface); border: 1px solid var(--surface-line);
    transition: transform 0.5s var(--ease), border-color 0.4s, box-shadow 0.5s var(--ease);
  }
  .ind__icon {
    flex: none; display: grid; place-items: center; width: 46px; height: 46px; border-radius: 13px;
    color: var(--gold-ink); background: rgba(201, 149, 74, 0.1); border: 1px solid rgba(201, 149, 74, 0.22);
    transition: background-color 0.35s, color 0.35s;
  }
  .ind__name { font-family: var(--font-head); font-weight: 600; font-size: 0.98rem; letter-spacing: -0.01em; line-height: 1.3; }
  .ind__tile:hover { transform: translateY(-3px); border-color: rgba(201, 149, 74, 0.4); box-shadow: 0 18px 36px -26px var(--shadow); }
  .ind__tile:hover .ind__icon { background: var(--gold); color: var(--black); }

  @media (max-width: 1000px) { .ind__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px) { .ind__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .ind__tile { flex-direction: column; align-items: flex-start; } }
</style>
