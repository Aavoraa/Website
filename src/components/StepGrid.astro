---
/** Numbered steps (growth method, how we start) with a connecting line. */
import LucideIcon from './LucideIcon.astro';
interface Props { items: { n: string; title: string; text: string; icon: string }[] }
const { items } = Astro.props;
---

<ol class="steps" style={`--cols:${items.length}`}>
  {
    items.map((s, i) => (
      <li class="step" data-reveal style={`--d:${i}`}>
        <span class="step__icon"><LucideIcon name={s.icon} size={22} /></span>
        <span class="step__n">{s.n}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps { position: relative; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 1rem; }
  .steps::before { /* connecting line through the icons */
    content: ''; position: absolute; top: 28px; left: calc(100% / var(--cols) / 2); right: calc(100% / var(--cols) / 2); height: 1px;
    background: linear-gradient(90deg, rgba(201, 149, 74, 0.1), rgba(201, 149, 74, 0.6), rgba(201, 149, 74, 0.1));
  }
  .step { position: relative; display: grid; align-content: start; justify-items: center; text-align: center; gap: 0.5rem; padding-inline: 0.25rem; }
  .step__icon {
    display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; color: var(--gold-ink);
    background: var(--node-bg); border: 1px solid rgba(201, 149, 74, 0.4); box-shadow: 0 0 0 6px rgba(201, 149, 74, 0.08);
  }
  .step__n { margin-top: 0.4rem; font-family: var(--font-head); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.12em; color: var(--gold-ink); }
  .step h3 { font-size: 1.15rem; }
  .step p { font-size: 0.9rem; line-height: 1.55; color: var(--text-light-muted); max-width: 15rem; }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 1.25rem; }
    .steps::before { top: 28px; bottom: 28px; left: 28px; right: auto; width: 1px; height: auto; background: linear-gradient(180deg, rgba(201, 149, 74, 0.1), rgba(201, 149, 74, 0.6), rgba(201, 149, 74, 0.1)); }
    .step { grid-template-columns: 56px 1fr; justify-items: start; text-align: left; column-gap: 1rem; row-gap: 0.2rem; }
    .step__icon { grid-row: span 3; }
    .step__n { margin: 0; }
    .step p { max-width: none; }
  }
</style>
