---
/** Marketing & Lead Generation — "growth funnel + channel dashboard". */
import LucideIcon from '../LucideIcon.astro';
import { subServicePath, subSlug, type ServiceDetail } from '../../data/pages';
import type { PillarKey } from '../../data/site';
interface Props {
  pillarKey: PillarKey;
  label: string;
  description: string;
  outcomes: string[];
  capabilities: { name: string; icon: string }[];
  details: ServiceDetail[];
}
const { pillarKey, label, description, outcomes, capabilities, details } = Astro.props;

// capabilities grouped into funnel stages (attention → conversion → pipeline)
const byName = (n: string) => capabilities.find((c) => c.name.toLowerCase().includes(n));
const stages = [
  { k: 'Attract', note: 'Be found and remembered', items: [byName('seo'), byName('social'), byName('digital marketing')] },
  { k: 'Convert', note: 'Turn attention into action', items: [byName('performance'), byName('conversion')] },
  { k: 'Capture', note: 'Qualified leads in your CRM', items: [byName('lead')] },
].map((s) => ({ ...s, items: s.items.filter(Boolean) as { name: string; icon: string }[] }));
const outcomeIcons = ['Search', 'Target', 'Database'];

// a gently rising sparkline per channel card (deterministic, illustrative only)
const spark = (seed: number) => {
  const pts: string[] = [];
  for (let i = 0; i <= 10; i++) {
    const y = 34 - i * 2.4 - 5 * Math.sin(i * 1.3 + seed) * (1 - i / 14);
    pts.push(`${i * 12},${Math.max(3, y).toFixed(1)}`);
  }
  return pts.join(' ');
};
---

<section class="section theme-dark flip fun-sec" data-theme="dark" aria-labelledby="fun-title">
  <div class="container">
    <header class="section-head section-head--center fun-head">
      <p class="eyebrow" data-reveal>The Growth Funnel</p>
      <h2 id="fun-title" class="ph2" data-reveal style="--d:1">{label}, <span class="accent">Measured.</span></h2>
      <p class="lead" data-reveal style="--d:2">{description}</p>
    </header>

    <div class="fun-wrap">
      <ol class="funnel">
        {
          stages.map((s, i) => (
            <li class="tier" style={`--i:${i}`} data-reveal>
              <div class="tier__label">
                <span class="tier__k">{s.k}</span>
                <span class="tier__note">{s.note}</span>
              </div>
              <ul class="tier__items">
                {s.items.map((c) => <li><LucideIcon name={c.icon} size={16} />{c.name}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
      <ul class="kpis">
        {
          outcomes.map((o, i) => (
            <li class="kpi pcard" data-reveal style={`--d:${i}`}>
              <span class="kpi__ico"><LucideIcon name={outcomeIcons[i % 3]} size={20} /></span>
              <span class="kpi__t">{o}</span>
              <svg class="kpi__bar" viewBox="0 0 60 24" aria-hidden="true">
                {[8, 12, 10, 16, 15, 21].map((h, j) => <rect x={j * 10} y={24 - h} width="6" height={h} rx="1.5" style={`--j:${j}`} />)}
              </svg>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="section theme-dark section--alt flip dash-sec" id="services-detail" data-theme="dark" aria-labelledby="dash-title">
  <div class="container">
    <header class="section-head section-head--center dash-head">
      <p class="eyebrow" data-reveal>Channel Dashboard</p>
      <h2 id="dash-title" class="ph2" data-reveal style="--d:1">Every Channel <span class="accent">Pulling Its Weight.</span></h2>
    </header>
    <ul class="dash" style={`--cols:${details.length % 3 === 0 ? 3 : 2}`}>
      {
        details.map((d, i) => (
          <li data-reveal style={`--d:${i % 3}`}>
            <article class="chan pcard">
              <header class="chan__head">
                <span class="chan__ico"><LucideIcon name={d.icon} size={20} /></span>
                <span class="chan__live"><i></i>Channel</span>
              </header>
              <h3><a href={subServicePath(pillarKey, d.name)}>{d.name}</a></h3>
              <svg class="chan__spark" viewBox="0 0 120 38" preserveAspectRatio="none" aria-hidden="true">
                <polyline points={spark(i)} />
              </svg>
              <p class="chan__sum">{d.summary}</p>
              {d.children && (
                <ul class="chan__kids" aria-label={`${d.name} services`}>
                  {d.children.map((c) => (
                    <li><a href={`${subServicePath(pillarKey, d.name)}${subSlug(c.name)}/`}><LucideIcon name={c.icon} size={14} />{c.name}</a></li>
                  ))}
                </ul>
              )}
              <a class="sub-link " href={subServicePath(pillarKey, d.name)}>Explore {d.name} <LucideIcon name="ArrowRight" size={15} /></a>
              <details class="chan__more">
                <summary>{d.deliverables.length} deliverables <LucideIcon name="ChevronDown" size={15} /></summary>
                <ul>{d.deliverables.map((x) => <li>{x}</li>)}</ul>
              </details>
              <dl class="chan__meta">
                <div><dt>Stack</dt><dd>{d.stack}</dd></div>
                <div><dt>Model</dt><dd>{d.model}</dd></div>
              </dl>
              {d.proof && (
                <a class="chan__proof" href={d.proof.slug ? `/work/${d.proof.slug}/` : undefined}>
                  <LucideIcon name="TrendingUp" size={15} /> <span>{d.proof.client}</span>
                </a>
              )}
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .fun-head, .dash-head { margin-bottom: clamp(2.25rem, 4.5vw, 3.25rem); }
  .fun-wrap { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }

  .funnel { display: grid; gap: 0.6rem; justify-items: center; }
  .tier {
    --w: calc(100% - var(--i) * 16%);
    width: var(--w); display: grid; grid-template-columns: 9rem 1fr; align-items: center; gap: 1rem;
    padding: 1.1rem 1.4rem; border-radius: 16px;
    background: linear-gradient(90deg, rgba(201, 149, 74, calc(0.1 + var(--i) * 0.08)), rgba(201, 149, 74, 0.04));
    border: 1px solid rgba(201, 149, 74, calc(0.22 + var(--i) * 0.15));
    clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 14px 100%);
  }
  .tier__label { display: grid; gap: 0.15rem; }
  .tier__k { font-family: var(--font-head); font-weight: 700; font-size: 1.25rem; letter-spacing: -0.01em; color: var(--gold-ink); }
  .tier__note { font-size: 0.75rem; color: var(--text-light-muted); }
  .tier__items { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tier__items li { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.7rem; border-radius: 999px; font-size: 0.82rem; font-weight: 500; background: var(--surface); border: 1px solid var(--surface-line); color: var(--ink); }
  .tier__items :global(svg) { color: var(--gold-ink); }

  .kpis { display: grid; gap: 0.85rem; }
  .kpi { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 1.1rem 1.25rem; }
  .kpi__ico { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: rgba(201, 149, 74, 0.1); color: var(--gold-ink); }
  .kpi__t { font-weight: 500; line-height: 1.4; color: var(--ink); }
  .kpi__bar { width: 60px; height: 24px; }
  .kpi__bar rect { fill: var(--gold); opacity: calc(0.35 + var(--j) * 0.12); transform-origin: bottom; transform-box: fill-box; transition: transform 0.6s var(--ease); }
  .kpi:hover .kpi__bar rect { transform: scaleY(1.15); }

  .dash { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 1rem; }
  .dash > li { display: flex; }
  .chan { display: flex; flex-direction: column; gap: 0.85rem; width: 100%; padding: 1.4rem; transition: transform 0.5s var(--ease), border-color 0.4s; }
  .chan:hover { transform: translateY(-4px); border-color: rgba(201, 149, 74, 0.45); }
  .chan__head { display: flex; align-items: center; justify-content: space-between; }
  .chan__ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: rgba(201, 149, 74, 0.1); color: var(--gold-ink); }
  .chan__live { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-light-muted); }
  .chan__live i { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 0 rgba(201, 149, 74, 0.6); animation: live 2.2s infinite; }
  @keyframes live { 70%, 100% { box-shadow: 0 0 0 8px rgba(201, 149, 74, 0); } }
  .chan h3 { font-size: 1.2rem; line-height: 1.25; }
  .chan__spark { width: 100%; height: 38px; }
  .chan__spark polyline { fill: none; stroke: var(--gold); stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 4px rgba(201, 149, 74, 0.5)); }
  .chan__sum { font-size: 0.9rem; line-height: 1.6; color: var(--text-light-muted); }
  .chan__kids { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chan__kids a { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.38rem 0.7rem; border-radius: 999px; font-size: 0.8rem; font-weight: 500; background: rgba(201, 149, 74, 0.08); border: 1px solid rgba(201, 149, 74, 0.22); color: var(--ink); transition: background-color 0.3s, border-color 0.3s; }
  .chan__kids a:hover { background: rgba(201, 149, 74, 0.16); border-color: rgba(201, 149, 74, 0.5); }
  .chan__kids :global(svg) { color: var(--gold-ink); }
  .chan__more summary { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; list-style: none; font-size: 0.82rem; font-weight: 500; color: var(--gold-ink); }
  .chan__more summary::-webkit-details-marker { display: none; }
  .chan__more[open] summary :global(svg) { transform: rotate(180deg); }
  .chan__more ul { display: grid; gap: 0.35rem; margin-top: 0.6rem; padding-left: 1rem; list-style: disc; font-size: 0.85rem; color: var(--ink); }
  .chan__meta { display: grid; gap: 0.5rem; margin-top: auto; padding-top: 0.85rem; border-top: 1px solid var(--line-light); }
  .chan__meta div { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.5rem; font-size: 0.8rem; }
  .chan__meta dt { font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.68rem; color: var(--gold-ink); padding-top: 0.1rem; }
  .chan__meta dd { color: var(--text-light-muted); }
  .chan__proof { display: inline-flex; align-items: center; gap: 0.45rem; align-self: flex-start; padding: 0.35rem 0.7rem; border-radius: 999px; font-size: 0.78rem; font-weight: 500; background: rgba(201, 149, 74, 0.1); color: var(--gold-ink); }
  a.chan__proof[href]:hover { background: rgba(201, 149, 74, 0.18); }

  @media (max-width: 1000px) { .fun-wrap { grid-template-columns: 1fr; } .dash { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .dash { grid-template-columns: 1fr; } .tier { --w: 100%; grid-template-columns: 1fr; clip-path: none; } }
</style>
