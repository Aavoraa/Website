---
import Icon from './Icon.astro';
import LucideIcon from './LucideIcon.astro';
const entryIcons = ['Search', 'CodeXml', 'Bot'];
import { entryPoints, interestOptions, integrations, site, bookingIsExternal, bookingHref } from '../data/site';
---

<section class="enq section theme-dark flip" id="contact" data-theme="dark" aria-labelledby="enq-title">
  <div class="enq__bg" aria-hidden="true"></div>
  <div class="container enq__grid">
    <div class="enq__intro">
      <p class="eyebrow" data-reveal>Start Here</p>
      <h2 id="enq-title" data-reveal style="--d:1">Let’s Identify <span class="accent">the Opportunity.</span></h2>
      <p class="lead" data-reveal style="--d:2">Start with a focused first step.</p>

      <ul class="enq__entries" aria-label="Ways to get started">
        {
          entryPoints.map((e, i) => (
            <li data-reveal style={`--d:${i + 2}`}>
              <a class="entry" href="#enquiry-form" data-entry={e.interest} data-offer={e.title} data-track="cta_secondary" data-track-location="entry_point" data-track-label={e.title}>
                <span class="entry__n"><LucideIcon name={entryIcons[i]} size={20} /></span>
                <span class="entry__body">
                  <span class="entry__title">{e.title}</span>
                </span>
                <Icon name="arrow" size={18} class="entry__arrow" />
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="enq__direct" data-reveal>
        <li><Icon name="mail" size={18} /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><Icon name="phone" size={18} /><a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a></li>
        {bookingIsExternal && (
          <li><Icon name="arrow-up-right" size={18} /><a href={bookingHref} target="_blank" rel="noopener" data-track="cta_primary" data-track-location="enquiry_direct">Book a discovery call online</a></li>
        )}
      </ul>
    </div>

    <div class="enq__panel" data-form-wrap data-reveal style="--d:1">
      <form
        id="enquiry-form"
        class="form"
        data-enquiry-form
        data-endpoint={integrations.formEndpoint}
        data-email={site.contact.email}
        novalidate
        aria-labelledby="form-title"
        aria-describedby="form-intro"
      >
        <h3 id="form-title" class="form__title">Tell us about your business</h3>
        <p id="form-intro" class="form__intro">A few details and we’ll take it from there.</p>

        <div class="form__row">
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-error" maxlength="120" />
            <p class="field__error" id="f-name-error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="f-email">Work email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="f-email-error" maxlength="160" />
            <p class="field__error" id="f-email-error" aria-live="polite"></p>
          </div>
        </div>

        <div class="field">
          <label for="f-company">Company name</label>
          <input id="f-company" name="company" type="text" autocomplete="organization" required aria-describedby="f-company-error" maxlength="160" />
          <p class="field__error" id="f-company-error" aria-live="polite"></p>
        </div>

        <div class="field">
          <label for="f-interest">What do you need help with?</label>
          <div class="select">
            <select id="f-interest" name="interest" required aria-describedby="f-interest-error">
              <option value="" selected disabled>Select an option</option>
              {interestOptions.map((o) => <option value={o}>{o}</option>)}
            </select>
            <Icon name="arrow" size={16} />
          </div>
          <p class="field__error" id="f-interest-error" aria-live="polite"></p>
        </div>

        <div class="field">
          <label for="f-message">Briefly describe your challenge <span class="opt">(optional)</span></label>
          <textarea id="f-message" name="message" rows="4" maxlength="1500" aria-describedby="f-message-error f-message-count"></textarea>
          <div class="field__meta">
            <p class="field__error" id="f-message-error" aria-live="polite"></p>
            <span id="f-message-count" class="field__count" data-count>0 / 1500</span>
          </div>
        </div>

        <input type="hidden" name="offer" id="f-offer" value="" />
        <div class="hp" aria-hidden="true">
          <label for="f-website">Leave this field empty</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button class="btn form__submit" type="submit">
          <span class="form__label">Book Free Strategic Consultation</span>
          <span class="form__spinner" aria-hidden="true"></span>
          <Icon name="arrow" class="arrow" />
        </button>

        <p class="form-status" data-form-status role="status" aria-live="polite" tabindex="-1"></p>
        <p class="form__privacy caption">We only use these details to respond to your enquiry. See our <a href="/privacy/">Privacy Policy</a>.</p>
      </form>

      <div class="form-success" data-form-success hidden tabindex="-1">
        <span class="form-success__icon"><Icon name="check" size={26} /></span>
        <h3>Thank you — your enquiry has been received.</h3>
        <p>We’ll review the details and come back to you by email. If it’s urgent, write to <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .enq { overflow: hidden; isolation: isolate; }
  .enq__bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse 45% 55% at 85% 30%, rgba(201, 149, 74, 0.16), transparent 70%),
      radial-gradient(ellipse 30% 40% at 0% 90%, rgba(201, 149, 74, 0.08), transparent 70%);
  }
  .enq__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .enq__intro { display: grid; gap: 1.5rem; }
  .enq__intro h2 { font-size: clamp(2rem, 1.2rem + 2.8vw, 3.4rem); }

  .enq__entries { display: grid; gap: 0.75rem; margin-top: 0.5rem; }
  .entry {
    display: grid; grid-template-columns: 40px 1fr auto; gap: 1rem; align-items: center;
    padding: 1.15rem 1.25rem; border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.03); border: 1px solid var(--line-dark-soft);
    transition: border-color 0.5s, background-color 0.5s, transform 0.6s var(--ease);
  }
  .entry:hover, .entry:focus-visible { border-color: rgba(201, 149, 74, 0.5); background: rgba(201, 149, 74, 0.06); transform: translateX(6px); }
  .entry__n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; color: var(--gold); background: rgba(201, 149, 74, 0.1); border: 1px solid rgba(201, 149, 74, 0.25); }
  .entry__body { display: grid; gap: 0.2rem; }
  .entry__title { font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; letter-spacing: -0.01em; }
  .entry__text { font-size: 0.85rem; color: var(--text-dark-muted); line-height: 1.5; }
  .entry :global(.entry__arrow) { color: var(--gold); transition: transform 0.5s var(--ease); }
  .entry:hover :global(.entry__arrow) { transform: translateX(4px); }
  .enq__terms { color: var(--text-dark-faint); }
  .enq__direct { display: flex; flex-wrap: wrap; gap: 0.75rem 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--line-dark-soft); }
  .enq__direct li { display: flex; align-items: center; gap: 0.6rem; font-size: 0.95rem; }
  .enq__direct :global(svg) { color: var(--gold); }
  .enq__direct a:hover { color: var(--gold); }

  /* ---------- Form panel ---------- */
  .enq__panel {
    position: relative; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 30px;
    background: linear-gradient(180deg, rgba(28, 24, 22, 0.92), rgba(16, 14, 13, 0.96));
    border: 1px solid rgba(201, 149, 74, 0.2);
    box-shadow: 0 50px 100px -40px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  .enq__panel::before {
    content: ''; position: absolute; left: 12%; right: 12%; top: -1px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .form { display: grid; gap: 1.1rem; }
  .form__title { font-size: 1.5rem; letter-spacing: -0.02em; }
  .form__intro { color: var(--text-dark-muted); font-size: 0.9rem; margin-top: -0.4rem; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-size: 0.85rem; font-weight: 500; color: rgba(255, 255, 255, 0.86); }
  .field .opt { font-weight: 300; color: var(--text-dark-faint); }
  .field input, .field select, .field textarea {
    width: 100%; min-height: 48px; padding: 0.75rem 1rem; border-radius: 14px;
    background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.14); color: var(--white);
    font-size: 1rem; transition: border-color 0.3s, background-color 0.3s, box-shadow 0.3s;
  }
  .field textarea { resize: vertical; min-height: 110px; line-height: 1.5; }
  .field input:hover, .field select:hover, .field textarea:hover { border-color: rgba(255, 255, 255, 0.26); }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--gold); background: rgba(201, 149, 74, 0.06); box-shadow: 0 0 0 3px rgba(201, 149, 74, 0.2);
  }
  .field.has-error input, .field.has-error select, .field.has-error textarea { border-color: #e2bd84; box-shadow: 0 0 0 3px rgba(226, 189, 132, 0.15); }
  .field__error { min-height: 0; font-size: 0.8rem; color: var(--gold-light); }
  .field__error:empty { display: none; }
  .field__meta { display: flex; justify-content: space-between; gap: 1rem; }
  .field__count { margin-left: auto; font-size: 0.75rem; color: var(--text-dark-faint); }
  .select { position: relative; }
  .select select { appearance: none; padding-right: 2.75rem; cursor: pointer; }
  .select select option { background: var(--black); color: var(--white); }
  .select :global(svg) { position: absolute; right: 1rem; top: 50%; translate: 0 -50%; rotate: 90deg; color: var(--gold); pointer-events: none; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .form__submit { width: 100%; margin-top: 0.4rem; }
  .form__spinner { display: none; width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(10, 9, 9, 0.3); border-top-color: var(--black); animation: spin 0.8s linear infinite; }
  .form__submit.is-loading { pointer-events: none; opacity: 0.85; }
  .form__submit.is-loading .form__spinner { display: inline-block; }
  .form__submit.is-loading :global(.arrow) { display: none; }
  .form__submit.is-loading .form__label::after { content: '…'; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .form-status { font-size: 0.875rem; line-height: 1.55; border-radius: 14px; }
  .form-status:empty { display: none; }
  .form-status:focus { outline: none; }
  :global(.form-status--error), :global(.form-status--info) { padding: 0.85rem 1rem; }
  :global(.form-status--error) { background: rgba(226, 189, 132, 0.1); border: 1px solid rgba(226, 189, 132, 0.4); color: var(--gold-light); }
  :global(.form-status--info) { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.16); color: rgba(255, 255, 255, 0.86); }
  .form-status :global(a) { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
  .form-status :global(strong) { color: var(--white); font-weight: 500; }
  .form__privacy { color: var(--text-dark-faint); }
  .form__privacy a { text-decoration: underline; text-underline-offset: 3px; }

  .form-success { display: grid; gap: 1rem; justify-items: start; padding: 1rem 0; outline: none; }
  .form-success[hidden] { display: none; }
  .form-success__icon { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--gold); color: var(--black); }
  .form-success h3 { font-size: 1.5rem; }
  .form-success p { color: var(--text-dark-muted); }
  .form-success a { color: var(--gold); }

  @media (max-width: 960px) {
    .enq__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .form__row { grid-template-columns: 1fr; }

    .entry { grid-template-columns: 40px 1fr auto; }
  }

  /* ---------- Light theme ---------- */
  :global(:root[data-theme='light']) .entry { background: #fff; border-color: rgba(10, 9, 9, 0.08); box-shadow: 0 10px 30px -22px rgba(10, 9, 9, 0.3); }
  :global(:root[data-theme='light']) .entry:hover, :global(:root[data-theme='light']) .entry:focus-visible { background: #fffdf9; border-color: rgba(201, 149, 74, 0.55); }
  :global(:root[data-theme='light']) .entry__n { color: var(--gold-ink); }
  :global(:root[data-theme='light']) .enq__direct a:hover { color: var(--gold-ink); }
  :global(:root[data-theme='light']) .enq__panel {
    background: #ffffff; border-color: rgba(201, 149, 74, 0.28);
    box-shadow: 0 50px 100px -50px rgba(10, 9, 9, 0.35), inset 0 1px 0 #fff;
  }
  :global(:root[data-theme='light']) .field label { color: rgba(10, 9, 9, 0.85); }
  :global(:root[data-theme='light']) .field input, :global(:root[data-theme='light']) .field select, :global(:root[data-theme='light']) .field textarea {
    background: #fdfcfa; border-color: rgba(10, 9, 9, 0.16); color: var(--black);
  }
  :global(:root[data-theme='light']) .field input:hover, :global(:root[data-theme='light']) .field select:hover, :global(:root[data-theme='light']) .field textarea:hover { border-color: rgba(10, 9, 9, 0.3); }
  :global(:root[data-theme='light']) .field input:focus, :global(:root[data-theme='light']) .field select:focus, :global(:root[data-theme='light']) .field textarea:focus { background: #fff; border-color: var(--gold-ink); box-shadow: 0 0 0 3px rgba(201, 149, 74, 0.22); }
  :global(:root[data-theme='light']) .field.has-error input, :global(:root[data-theme='light']) .field.has-error select, :global(:root[data-theme='light']) .field.has-error textarea { border-color: var(--gold-ink); }
  :global(:root[data-theme='light']) .field__error { color: var(--gold-ink); }
  :global(:root[data-theme='light']) .select select option { background: #fff; color: var(--black); }
  :global(:root[data-theme='light']) .select :global(svg) { color: var(--gold-ink); }
  :global(:root[data-theme='light']) :global(.form-status--error) { background: rgba(201, 149, 74, 0.1); border-color: rgba(138, 92, 36, 0.4); color: var(--gold-deep); }
  :global(:root[data-theme='light']) :global(.form-status--info) { background: rgba(10, 9, 9, 0.03); border-color: rgba(10, 9, 9, 0.12); color: rgba(10, 9, 9, 0.85); }
  :global(:root[data-theme='light']) .form-status :global(a), :global(:root[data-theme='light']) .form-success a { color: var(--gold-ink); }
  :global(:root[data-theme='light']) .form-status :global(strong) { color: var(--black); }
</style>
